<Window
    x:Class="TaskCleaner.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:tb="using:H.NotifyIcon"
    xmlns:models="using:TaskCleaner.Core.Models"
    xmlns:vm="using:TaskCleaner.WinUI.ViewModels"
    mc:Ignorable="d"
    Title="Task Cleaner">

    <Window.SystemBackdrop>
        <MicaBackdrop Kind="BaseAlt" />
    </Window.SystemBackdrop>

    <Grid>
        <!-- 系统任务栏托盘托管组件 (H.NotifyIcon) -->
        <tb:TaskbarIcon
            x:Name="TrayIcon"
            ToolTipText="Task Cleaner"
            LeftClickCommand="{x:Bind ToggleWindowVisibilityCommand}">
            <tb:TaskbarIcon.ContextFlyout>
                <MenuFlyout>
                    <MenuFlyoutItem Text="打开 Task Cleaner" Click="OnShowFromTrayClicked">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE737;" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem Text="扫描刷新" Click="OnRefreshClicked">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE72C;" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Text="退出" Click="OnQuitClicked">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE711;" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                </MenuFlyout>
            </tb:TaskbarIcon.ContextFlyout>
        </tb:TaskbarIcon>

        <!-- 主面板容器 -->
        <Grid Padding="12,10,12,8" RowDefinitions="Auto,Auto,Auto,*,Auto">
            
            <!-- 1. 顶栏 (Header) -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="Task Cleaner" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
                    <Border CornerRadius="8" Background="#140078D4" BorderBrush="#200078D4" BorderThickness="1" Padding="6,1">
                        <TextBlock Text="{x:Bind ViewModel.TotalRunning, Mode=OneWay, Converter={StaticResource StringFormatConverter}, ConverterParameter='{}{0} 运行中'}" 
                                   FontSize="10.5" Foreground="#0078D4" FontWeight="Medium" />
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                    <Button Command="{x:Bind ViewModel.RefreshCommand}" Padding="5" Background="Transparent" BorderBrush="Transparent" ToolTipService.ToolTip="重新扫描前台应用">
                        <FontIcon Glyph="&#xE72C;" FontSize="11" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- 2. 核心操作卡片 (Action Card) -->
            <Border Grid.Row="1" Margin="0,8,0,0" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Padding="10">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind ViewModel.TargetCount, Mode=OneWay, Converter={StaticResource StringFormatConverter}, ConverterParameter='{}{0} 个待结束应用'}" 
                                   FontWeight="SemiBold" FontSize="12" />
                        <TextBlock Text="结束未受保护的前台任务" FontSize="10.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>

                    <Button Grid.Column="1" 
                            Command="{x:Bind ViewModel.CleanAllCommand}" 
                            IsEnabled="{x:Bind ViewModel.HasTargets, Mode=OneWay}"
                            Content="{x:Bind ViewModel.ActionButtonText, Mode=OneWay}"
                            Style="{StaticResource AccentButtonStyle}"
                            FontSize="11.5" FontWeight="SemiBold" Padding="12,5" />
                </Grid>
            </Border>

            <!-- 3. 分段选择器与排序选项 -->
            <Grid Grid.Row="2" Margin="0,8,0,4" ColumnDefinitions="*,Auto">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <Button Content="待结束" Click="OnTabPendingClicked" Padding="8,4" FontSize="11" />
                    <Button Content="已保护" Click="OnTabProtectedClicked" Padding="8,4" FontSize="11" />
                    <Button Content="全部" Click="OnTabAllClicked" Padding="8,4" FontSize="11" />
                </StackPanel>

                <ComboBox Grid.Column="1" SelectedIndex="0" SelectionChanged="OnSortSelectionChanged" FontSize="10.5" Padding="6,3" MinWidth="95">
                    <ComboBoxItem Content="综合负载" Tag="Composite" />
                    <ComboBoxItem Content="内存占用" Tag="Memory" />
                    <ComboBoxItem Content="CPU 占用" Tag="Cpu" />
                    <ComboBoxItem Content="窗口数量" Tag="Windows" />
                    <ComboBoxItem Content="默认顺序" Tag="Default" />
                </ComboBox>
            </Grid>

            <!-- 4. 应用程序列表区 (流畅滚动) -->
            <ListView Grid.Row="3" 
                      ItemsSource="{x:Bind ViewModel.DisplayedProcesses, Mode=OneWay}" 
                      SelectionMode="None"
                      Padding="0" Margin="0,2,0,0">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:ProcessEntry">
                        <Grid Padding="4,6" ColumnDefinitions="Auto,*,Auto" CornerRadius="6">
                            <!-- 图标占位 -->
                            <FontIcon Glyph="&#xE737;" FontSize="16" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />

                            <!-- 应用名称与标识 -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                <TextBlock Text="{x:Bind DisplayTitle}" FontWeight="Medium" FontSize="11.5" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{x:Bind Subtitle}" FontSize="9.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                            <!-- 遥测指标徽章与单行操作 -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="4" Padding="5,2" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                    <TextBlock Text="{x:Bind MetricsDisplay}" FontSize="9" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </Border>

                                <Button Click="OnProcessActionClicked" Padding="4" Background="Transparent" BorderBrush="Transparent" ToolTipService.ToolTip="操作">
                                    <FontIcon Glyph="&#xE74D;" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </Button>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!-- 5. 底栏工具条 (Footer) -->
            <Grid Grid.Row="4" Margin="0,6,0,0" ColumnDefinitions="*,Auto">
                <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" 
                           FontSize="10.5" 
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" 
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                    <Button Click="OnSettingsClicked" Padding="5" Background="Transparent" BorderBrush="Transparent" ToolTipService.ToolTip="设置与配置">
                        <FontIcon Glyph="&#xE713;" FontSize="11" />
                    </Button>
                    <Button Click="OnQuitClicked" Padding="5" Background="Transparent" BorderBrush="Transparent" ToolTipService.ToolTip="退出">
                        <FontIcon Glyph="&#xE7E8;" FontSize="11" />
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
