<Application
    x:Class="TaskCleaner.WinUI.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="using:TaskCleaner.WinUI.Helpers">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <helpers:StringFormatConverter x:Key="StringFormatConverter" />

            <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#18FFFFFF" />
            <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#22FFFFFF" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
